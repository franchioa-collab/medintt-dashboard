# --- Chequeos periódicos por push (Etapa 2) ---
# Generar una sola vez con: node -e "console.log(require('web-push').generateVAPIDKeys())"
NEXT_PUBLIC_VAPID_PUBLIC_KEY="clave-publica-vapid"
VAPID_PRIVATE_KEY="clave-privada-vapid"
# Contacto de referencia que exige el protocolo Web Push (mailto: o https:)
VAPID_SUBJECT="mailto:soporte@medintt.com"
# Secreto compartido para autenticar el llamado programado que dispara los avisos.
# Generar con: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CRON_SECRET="secreto-largo-al-azar"
